Window.SetBackgroundTopColor(0.02, 0.02, 0.03);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.03);

# Pas de .Scale() vers la pleine résolution d'écran : image centrée à sa
# taille native, comme le fait le thème d'exemple officiel de Plymouth
# (usr/share/plymouth/themes/script/script.script) - une mise à l'échelle
# plein écran s'est avérée trop coûteuse/peu fiable dans l'environnement
# contraint de l'initramfs (image jamais affichée, alors que le thème
# "spinner" natif, lui, fonctionnait).
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

fun refresh_callback() {
    time = Plymouth.GetTime();
    opacity = 0.55 + 0.45 * Math.Sin(time * 2);
    logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
